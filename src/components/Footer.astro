---
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>

<div class="companion-bar">
	<span class="companion-label">Kardeş Web Kitapları:</span>
	<a href="https://ytalharabaci.github.io/siber-guvenlik-operasyonlari/" class="companion-link" target="_blank" rel="noopener">🛡️ Siber Güvenlik Operasyonları</a>
	<span class="companion-dot" aria-hidden="true">•</span>
	<a href="https://ytalharabaci.github.io/ag-yonetimi-ve-guvenligi/" class="companion-link" target="_blank" rel="noopener">🌐 Ağ Yönetimi ve Güvenliği</a>
</div>

<style>
	.companion-bar {
		margin-top: 1.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--sl-color-gray-6, rgba(255, 255, 255, 0.08));
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		font-size: 0.85rem;
		color: var(--sl-color-gray-3, #94a3b8);
	}
	.companion-label {
		font-weight: 600;
		color: var(--sl-color-gray-2, #cbd5e1);
	}
	.companion-link {
		color: var(--sl-color-accent, #6366f1);
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.companion-link:hover {
		color: var(--sl-color-white, #fff);
		text-decoration: underline;
	}
	.companion-dot {
		opacity: 0.4;
	}
</style>
